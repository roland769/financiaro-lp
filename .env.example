# Twilio (Console → Account Info / Verify → Services)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VERIFY_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: run Twilio Lookup before sending (filters landlines/VOIP, ~$0.008/call). 1 = on
TWILIO_LOOKUP=0

# Your CRM / Zapier / Make / GoHighLevel inbound webhook. Leave empty to just log leads in Vercel.
CRM_WEBHOOK_URL=
# Optional shared secret: every lead POST carries an HMAC-SHA256 signature in X-Signature
CRM_WEBHOOK_SECRET=

# Optional: comma-separated origins allowed to call the API when the page is hosted elsewhere
ALLOWED_ORIGINS=
