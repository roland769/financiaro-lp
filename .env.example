# Twilio (Console → Account Info / Verify → Services)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VERIFY_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Twilio Lookup before sending (filters landlines/VOIP, ~$0.008/call). 1 = on
TWILIO_LOOKUP=0

# GoHighLevel / LeadConnector inbound webhook (Automation → Workflow → Inbound Webhook trigger)
CRM_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/xxxx/webhook-trigger/xxxx
# Optional: which stages to forward (default: all). Example for qualified phone leads only:
# CRM_FORWARD_STAGES=complete,verified,updated
CRM_FORWARD_STAGES=
# Optional shared secret: adds an HMAC-SHA256 signature in the X-Signature header
CRM_WEBHOOK_SECRET=
# Optional: comma-separated origins allowed to call the API when the page is hosted elsewhere
ALLOWED_ORIGINS=
